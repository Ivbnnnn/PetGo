<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.petgo.controller.UserFormController"
            fitToWidth="true"
            prefViewportWidth="480"
            prefViewportHeight="500">

    <content>
        <VBox spacing="10" prefWidth="440">
            <padding>
                <Insets top="20" right="22" bottom="20" left="22"/>
            </padding>

            <Label fx:id="titleLabel" text="Пользователь" styleClass="form-title"/>

            <Label text="Имя"/>
            <TextField fx:id="nameField" promptText="Иван Иванов"/>

            <Label text="Email"/>
            <TextField fx:id="emailField" promptText="user@mail.ru"/>

            <Label text="Телефон"/>
            <TextField fx:id="phoneField" promptText="+79161234567"/>

            <Label text="Роль"/>
            <ComboBox fx:id="roleComboBox" maxWidth="Infinity" promptText="Выберите роль"/>

            <Label text="Адрес"/>
            <TextField fx:id="addressField" promptText="Город, улица, дом"/>

            <CheckBox fx:id="activeCheckBox" text="Активен"/>

            <Label fx:id="errorLabel" wrapText="true" styleClass="error-label"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Отмена" onAction="#handleCancel" cancelButton="true"/>
                <Button text="Сохранить" onAction="#handleSave" defaultButton="true" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>