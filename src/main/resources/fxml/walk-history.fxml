<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.petgo.controller.WalkHistoryController"
            stylesheets="@../css/app.css">

    <top>
        <VBox spacing="10" styleClass="toolbar">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="История прогулок" styleClass="form-title"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Минимальная оценка:"/>
                <ComboBox fx:id="ratingFilter" promptText="Все" prefWidth="120"/>
                <Button text="Применить" onAction="#handleRefresh"/>
                <Button text="Сбросить" onAction="#handleReset"/>
            </HBox>

            <Separator/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Добавить" onAction="#handleAdd" styleClass="primary-button"/>
                <Button text="Изменить" onAction="#handleEdit"/>
                <Button text="Удалить" onAction="#handleDelete"/>
                <Button text="Обновить" onAction="#handleRefresh"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Всего:"/>
                <Label fx:id="countLabel" text="0"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="historyTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="requestIdColumn" text="Заявка" prefWidth="70"/>
                <TableColumn fx:id="petColumn" text="Питомец" prefWidth="120"/>
                <TableColumn fx:id="walkDateColumn" text="Дата прогулки" prefWidth="140"/>
                <TableColumn fx:id="durationColumn" text="Длит., мин" prefWidth="90"/>
                <TableColumn fx:id="routeColumn" text="Маршрут" prefWidth="160"/>
                <TableColumn fx:id="ownerReviewColumn" text="Отзыв владельца" prefWidth="180"/>
                <TableColumn fx:id="walkerReviewColumn" text="Отзыв выгульщика" prefWidth="180"/>
                <TableColumn fx:id="ratingColumn" text="Оценка" prefWidth="80"/>
                <TableColumn fx:id="completedAtColumn" text="Завершена" prefWidth="140"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <Label fx:id="messageLabel" textFill="red"/>
        </VBox>
    </bottom>
</BorderPane>