<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="ru.mirea.petgo.controller.PetFormController"
          hgap="10" vgap="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label fx:id="titleLabel" text="Питомец"
           GridPane.columnSpan="2"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label text="Кличка:" GridPane.rowIndex="1"/>
    <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

    <Label text="Порода:" GridPane.rowIndex="2"/>
    <TextField fx:id="breedField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Вес (кг):" GridPane.rowIndex="3"/>
    <TextField fx:id="weightField" GridPane.rowIndex="3" GridPane.columnIndex="1"
               promptText="например 4.50"/>

    <Label text="Возраст:" GridPane.rowIndex="4"/>
    <TextField fx:id="ageField" GridPane.rowIndex="4" GridPane.columnIndex="1"
               promptText="например 3"/>

    <Label text="Особые потребности:" GridPane.rowIndex="5"
           GridPane.valignment="TOP"/>
    <TextArea fx:id="needsArea" GridPane.rowIndex="5" GridPane.columnIndex="1"
              prefHeight="80"/>

    <Label text="Владелец:" GridPane.rowIndex="6"/>
    <ComboBox fx:id="ownerComboBox" GridPane.rowIndex="6" GridPane.columnIndex="1"
              prefWidth="250"/>

    <Label text="Фото (URL):" GridPane.rowIndex="7"/>
    <TextField fx:id="photoField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

    <Label fx:id="errorLabel" textFill="red"
           GridPane.rowIndex="8" GridPane.columnSpan="2"/>

    <HBox spacing="10" GridPane.rowIndex="9" GridPane.columnSpan="2">
        <Button text="Сохранить" onAction="#handleSave" defaultButton="true"/>
        <Button text="Отмена" onAction="#handleCancel" cancelButton="true"/>
    </HBox>
</GridPane>