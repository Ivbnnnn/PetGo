<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.petgo.controller.UsersController"
            stylesheets="@../css/app.css">

    <top>
        <VBox spacing="10" styleClass="toolbar">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Пользователи" styleClass="form-title"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Поиск по имени или email"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Найти" onAction="#handleRefresh"/>
                <Button text="Сбросить" onAction="#handleReset"/>
            </HBox>

            <Separator/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Добавить" onAction="#handleAdd" styleClass="primary-button"/>
                <Button text="Изменить" onAction="#handleEdit"/>
                <Button text="Удалить" onAction="#handleDelete"/>
                <Button text="Обновить" onAction="#handleRefresh"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Всего:"/>
                <Label fx:id="countLabel" text="0"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="usersTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="nameColumn" text="Имя" prefWidth="180"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="150"/>
                <TableColumn fx:id="roleColumn" text="Роль" prefWidth="120"/>
                <TableColumn fx:id="addressColumn" text="Адрес" prefWidth="200"/>
                <TableColumn fx:id="activeColumn" text="Активен" prefWidth="90"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <Label text="Информация о выбранном пользователе" styleClass="form-title"/>
            <Label fx:id="detailsLabel" text="Выберите пользователя для просмотра." wrapText="true"/>

            <Separator/>

            <Label fx:id="messageLabel" textFill="red"/>
        </VBox>
    </bottom>
</BorderPane>